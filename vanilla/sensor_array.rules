PartCrew
{
	Type = MultiToggle
	Toggles = [PartCrewMinusNone, PartCrewMinusOne, PartCrewMinusTwo, PartCrewMinusThree, PartCrewMinusFour]
	Mode = Any
}

NeedsPartCrewMinusNone
{
	Type = MultiToggle
	Toggles = [PartCrewMinusOne, PartCrewMinusTwo, PartCrewMinusThree, PartCrewMinusFour]
	Mode = Any
	Invert = True
}

PartCrewMinusNone
{
	Type = PartCrew
	Crew = 4
	DefaultPriority = &/PRIORITIES/PriorityUtility_Crew
	PrerequisitesBeforeCrewing = [CommandConsumptionToggle, NeedsPartCrewMinusNone]
	HighPriorityPrerequisites = [BatteryStorage]
